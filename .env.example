# Turso Database Configuration for Pertamina International Timor PM Portal
TURSO_DATABASE_URL=libsql://pmpitsa-anfal.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here


# Secret untuk menandatangani cookie sesi login (wajib di production, min. 32 karakter acak)
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=ganti_dengan_string_acak_panjang
