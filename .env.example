# Turso Database Configuration for Pertamina International Timor PM Portal
TURSO_DATABASE_URL=libsql://pmpitsa-anfal.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here


# Secret untuk menandatangani cookie sesi login (wajib di production, min. 32 karakter acak)
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=ganti_dengan_string_acak_panjang

# ---- Arsip Berita Acara ke Google Drive (opsional) ----
# Opsi A (akun Gmail pribadi): OAuth client "Desktop app" + refresh token.
# Dapatkan refresh token dengan: GOOGLE_CLIENT_ID=.. GOOGLE_CLIENT_SECRET=.. node scripts/google-drive-auth.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opsi B (Google Workspace): Service account + folder di Shared Drive yang dibagikan ke email service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ID folder induk arsip (bagian akhir URL folder Drive). Opsional untuk Opsi A
# (otomatis dibuat folder "Arsip BA PM POS PINSYST - PITSA"), wajib untuk Opsi B.
GOOGLE_DRIVE_FOLDER_ID=
